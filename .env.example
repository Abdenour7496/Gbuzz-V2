# Copy to .env and replace every change-me value before starting the stack.
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=change-me-postgres
# Runtime services connect as this restricted role (created by gcor-migrate, member of
# gcor_app: data only, no DDL, no superuser, no RLS bypass). Set both or neither;
# leaving both empty keeps every service on POSTGRES_USER as before.
GCOR_DB_USER=gcor_runtime
GCOR_DB_PASSWORD=change-me-gcor-runtime
REDIS_PASSWORD=change-me-redis
BUZZ_S3_ACCESS_KEY=buzz-local
BUZZ_S3_SECRET_KEY=change-me-minio
# GCOR object-store credentials. When set, minio-init creates this MinIO user with a
# policy limited to the GCOR bucket and buckets named GCOR_CHANNEL_BUCKET_PREFIX*, and
# gcor-proxy stops using the root keys. Set all three or none. Existing deployments
# with unprefixed channel buckets must migrate those buckets before enabling this.
GCOR_S3_ACCESS_KEY=gcor-service
GCOR_S3_SECRET_KEY=change-me-gcor-s3
GCOR_CHANNEL_BUCKET_PREFIX=gcor-ch-
INGEST_WEBHOOK_SECRET=change-me-ingest
STACK_API_SECRET=change-me-stack-api
OPENAI_API_KEY=change-me-openai

# Keep administrative and MCP endpoints on loopback unless a trusted reverse
# proxy provides TLS and authentication.
BUZZ_HTTP_BIND_ADDR=0.0.0.0
BUZZ_HTTP_PORT=3000
MINIO_BIND_ADDR=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
GCOR_PROXY_BIND_ADDR=127.0.0.1
GCOR_PROXY_PORT=5001
GCOR_MCP_BIND_ADDR=127.0.0.1
GCOR_MCP_PORT=8765
GRAPHITI_MCP_BIND_ADDR=127.0.0.1
GRAPHITI_MCP_PORT=8000

# Built-in bounded recovery controller. Keep its read-only status API on
# loopback. It automatically restarts labelled stateless services only.
RECOVERY_BIND_ADDR=127.0.0.1
RECOVERY_PORT=8082
RECOVERY_STACK_ID=gbuzz
RECOVERY_POLL_SECONDS=15
RECOVERY_FAILURE_THRESHOLD=3
RECOVERY_COOLDOWN_SECONDS=300
RECOVERY_MAX_ACTIONS_PER_WINDOW=3
RECOVERY_ACTION_WINDOW_SECONDS=3600
RECOVERY_RESTART_TIMEOUT_SECONDS=20

# Host-scheduled full-stack refresh. The updater pulls the configured tags,
# rebuilds workspace-owned images, recreates the stack, and waits for health.
AUTO_UPDATE_ENABLED=false
AUTO_UPDATE_INCLUDE_OBSERVABILITY=false
AUTO_UPDATE_INCLUDE_GRAPH=false
AUTO_UPDATE_WAIT_TIMEOUT_SECONDS=300

# Production deployments should pin this to an immutable digest.
BUZZ_IMAGE=ghcr.io/block/buzz:0.2.1
BUZZ_AUTO_MIGRATE=true
ENFORCE_STACK_API_SECRET=true
REMOTE_FETCH_BLOCK_PRIVATE_HOSTS=true

# Per proxy process; raise only after checking memory and inference capacity.
MAX_INGEST_FILE_BYTES=26214400
MAX_REQUEST_BODY_BYTES=27262976
MAX_API_IN_FLIGHT=4
REQUEST_BODY_TIMEOUT_SECONDS=60
MAX_QUERY_CHARS=10000
MAX_ATTACHMENT_TOTAL_BYTES=104857600
ATTACHMENT_REPLAY_BUDGET_SECONDS=120
REMOTE_FETCH_TOTAL_TIMEOUT_SECONDS=60

# Optional observability profile. Always replace the Grafana password.
OBSERVABILITY_BIND_ADDR=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
ALERTMANAGER_PORT=9093
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
PROMETHEUS_RETENTION=15d

# Production release accountability. These must identify real people or teams;
# scripts/production-preflight.ps1 rejects empty and placeholder values.
RELEASE_OWNER=change-me-release-owner
ROLLBACK_OWNER=change-me-rollback-owner
MIGRATION_OWNER=change-me-migration-owner
ON_CALL_CONTACT=change-me-on-call-contact

# Production must mount a deployment-specific Alertmanager configuration with
# at least one non-local receiver. The local file remains useful for exercises.
ALERTMANAGER_CONFIG_FILE=./observability/alertmanager.production.yml

# Optional docker-compose.buzz.yml: dedicated service key, never an employee key.
# BUZZ_KNOWLEDGE_PRIVATE_KEY=<generated 64-character hex secret>
# BUZZ_KNOWLEDGE_AUTH_URL=ws://127.0.0.1:3000
# Event knowledge promotion: selective archives chatter without indexing it;
# all restores historical index-everything behavior; archive_only disables promotion.
PROJECTOR_KNOWLEDGE_MODE=selective
# Dedicated 32-byte lowercase hex key used only to seal Audit Pack manifests.
# Generate and store it through the deployment secret manager; never reuse a user or relay key.
AUDIT_PACK_SIGNING_KEY=
AUDIT_PACK_MAX_EVENTS=5000
AUDIT_PACK_MAX_BYTES=104857600
AUDIT_PACK_MAX_RANGE_DAYS=366
BUZZ_MEDIA_BUCKET=buzz-media
