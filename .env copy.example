# Copy to .env and replace every CHANGE_ME value with stable secrets.
# This file runs a complete standalone Buzz + GCOR stack; no external Docker network is required.
BUZZ_IMAGE=ghcr.io/block/buzz:main
BUZZ_HTTP_PORT=3000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Local development defaults. Set true and provide RELAY_OWNER_PUBKEY to close the relay.
BUZZ_REQUIRE_AUTH_TOKEN=false
BUZZ_REQUIRE_RELAY_MEMBERSHIP=false
BUZZ_ALLOW_IP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX

POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
BUZZ_S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
BUZZ_S3_BUCKET=buzz-media
GCOR_S3_BUCKET=buzz-gcor

# The default embedding provider runs in this Compose stack. For OpenAI, change
# these to `openai`, `text-embedding-3-small`, `1536`, and set OPENAI_API_KEY.
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMS=768
OPENAI_API_KEY=

INGEST_WEBHOOK_SECRET=CHANGE_ME_INGEST_WEBHOOK_SECRET
GCOR_PROXY_PORT=5001
GCOR_MCP_PORT=8765