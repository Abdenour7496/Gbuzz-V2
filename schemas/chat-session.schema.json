{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbuzz.local/schemas/chat-session.schema.json",
  "title": "Chat Session Record",
  "type": "object",
  "required": [
    "session_id",
    "channel_name",
    "channel_id",
    "started_at",
    "messages"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "channel_name": {
      "type": "string",
      "minLength": 1
    },
    "channel_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["message_id", "author_pubkey", "created_at"],
        "properties": {
          "message_id": {
            "type": "string",
            "minLength": 1
          },
          "author_pubkey": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "content": {
            "type": "string"
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url"],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "name": {
                  "type": "string"
                },
                "file_name": {
                  "type": "string"
                },
                "media_type": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
