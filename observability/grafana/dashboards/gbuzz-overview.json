    {"type": "timeseries", "title": "PostgreSQL connections", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "sum(pg_stat_activity_count)", "legendFormat": "connections", "refId": "A"}]},
