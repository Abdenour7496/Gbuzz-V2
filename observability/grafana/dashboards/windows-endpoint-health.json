    {
      "type": "table",
      "title": "Active endpoint alerts",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 7
      },
      "options": {
        "showHeader": true
      },
      "id": 12,
      "fieldConfig": {
        "defaults": {
          "noValue": "No active alerts"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=~\"pending|firing\",job=\"windows\",instance=~\"$instance\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "description": "Live Prometheus pending and firing alerts. No rows means no active alerts.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "Value": true
            },
            "renameByName": {
              "alertname": "Alert",
              "endpoint": "Device",
              "instance": "Target",
              "severity": "Severity",
              "alertstate": "State",
              "job": "Service"
            }
          }
        }
      ]
    },
