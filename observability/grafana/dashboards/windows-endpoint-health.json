        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (instance, endpoint, nic) (rate(windows_net_bytes_received_total{job=\"windows\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{endpoint}} · {{nic}} · receive",
          "refId": "A"
        },
        {
          "expr": "sum by (instance, endpoint, nic) (rate(windows_net_bytes_sent_total{job=\"windows\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{endpoint}} · {{nic}} · send",
          "refId": "B"
        }
      ],
      "id": 10
