{
  "annotations": {
    "list": []
  },
  "editable": false,
  "panels": [
    {
      "type": "stat",
      "title": "Endpoint telemetry",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=\"windows\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{endpoint}}",
          "instant": true
        }
      ],
      "id": 1,
      "description": "One status per configured device. A healthy device never hides an unavailable one.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "CPU used",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - avg by (instance, endpoint) (rate(windows_cpu_time_total{job=\"windows\",instance=~\"$instance\",mode=\"idle\"}[5m])) * 100",
          "refId": "A",
          "legendFormat": "{{endpoint}}",
          "instant": true
        }
      ],
      "id": 2,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Memory used",
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - 100 * windows_memory_physical_free_bytes{job=\"windows\",instance=~\"$instance\"} / windows_memory_physical_total_bytes{job=\"windows\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{endpoint}}",
          "instant": true
        }
      ],
      "id": 3,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Lowest disk free",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "green",
                "value": 25
              }
            ]
          },
          "noValue": "No telemetry"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "min by (instance, endpoint) (100 * windows_logical_disk_free_bytes{job=\"windows\",instance=~\"$instance\",volume=~\"[A-Z]:\"} / windows_logical_disk_size_bytes{job=\"windows\",instance=~\"$instance\",volume=~\"[A-Z]:\"})",
          "refId": "A",
          "legendFormat": "{{endpoint}}",
          "instant": true
        }
      ],
      "id": 4,
      "description": "Least free capacity across drive-letter volumes on each selected device.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
