        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - windows_system_boot_time_timestamp{job=\"windows\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{endpoint}}",
          "instant": true
