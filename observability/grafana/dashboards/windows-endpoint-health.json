      "targets": [
        {
          "expr": "rate(windows_logical_disk_read_bytes_total{job=\"windows\",instance=~\"$instance\",volume=~\"[A-Z]:\"}[5m])",
          "legendFormat": "{{endpoint}} · {{volume}} · read",
          "refId": "A"
        },
        {
          "expr": "rate(windows_logical_disk_write_bytes_total{job=\"windows\",instance=~\"$instance\",volume=~\"[A-Z]:\"}[5m])",
          "legendFormat": "{{endpoint}} · {{volume}} · write",
          "refId": "B"
