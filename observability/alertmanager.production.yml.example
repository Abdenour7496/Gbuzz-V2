# Copy to alertmanager.production.yml (gitignored), replace the URL with the
# deployment's real incident destination, and test delivery before promotion.
route:
  receiver: production-on-call
  group_by: [alertname, job]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: production-on-call
    webhook_configs:
      - url: https://REPLACE_WITH_APPROVED_ON_CALL_WEBHOOK
        send_resolved: true
